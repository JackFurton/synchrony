{ pkgs, synchrony }:

# The chain is enforced by the virtual network, not by firewall rules: node3
# has no interface on vlan1 at all, so it cannot reach source even in principle.
#
#   source --vlan1-- node1 --vlan2-- node2 --vlan3-- node3
let
  port = 9000;
  cachePort = 5000;

  # Every node serves a binary cache on cachePort. source's is nix-serve over
  # its own store. Everyone else's is an nginx cache in front of its upstream's,
  # and its own Nix daemon substitutes from that upstream and nothing else. So a
  # path built on source reaches node3 by being pulled through node2 and node1,
  # each keeping a copy on the way past. nix-serve alone could not do that: it
  # serves its own store and answers 404 for anything it has not got.
  cache = { upstream, vlans }: { lib, nodes, ... }:
    let
      # By address, not name. A name resolves to every address the node has,
      # one per vlan, and nginx tries each in turn: node2 sat out the 60s
      # connect timeout on node1's vlan1 address before trying the right one.
      upstreamUrl =
        let
          up = nodes.${upstream};
          shared = builtins.head (lib.intersectLists vlans up.virtualisation.vlans);
          eth = "eth${toString (lib.lists.findFirstIndex (v: v == shared) null up.virtualisation.vlans + 1)}";
        in
        "http://${(builtins.head up.networking.interfaces.${eth}.ipv4.addresses).address}:${toString cachePort}";
    in
    {
    networking.firewall.allowedTCPPorts = [ cachePort ];

    services.nginx = {
      enable = true;
      commonHttpConfig = ''
        log_format cache '$request_method $uri $status $upstream_cache_status $body_bytes_sent $request_time';
        proxy_cache_path /var/cache/nginx/nix keys_zone=nix:10m max_size=1g inactive=1d use_temp_path=off;
      '';
      virtualHosts.cache = {
        listen = [{ addr = "0.0.0.0"; port = cachePort; }];
        extraConfig = "access_log /var/log/nginx/cache.log cache;";
        locations."/" = {
          proxyPass =
            if upstream == null then "http://127.0.0.1:${toString (cachePort + 1)}"
            else upstreamUrl;
          # Only 200s: a 404 cached while source was still building would hide
          # the path once it existed. And only one request per path goes
          # upstream however many arrive at once.
          extraConfig = lib.optionalString (upstream != null) ''
            proxy_cache nix;
            proxy_cache_valid 200 1d;
            proxy_cache_lock on;
          '';
        };
      };
    };

    services.nix-serve = lib.mkIf (upstream == null) {
      enable = true;
      bindAddress = "127.0.0.1";
      port = cachePort + 1;
      secretKeyFile = "/run/cache.sec";
    };
    # The key is generated by the test script, so this waits to be started.
    systemd.services.nix-serve.wantedBy = lib.mkIf (upstream == null) (lib.mkForce [ ]);

    nix.settings.substituters =
      lib.mkForce (lib.optional (upstream != null) upstreamUrl);
    };

  # Long enough that the outage subtest's writes are still accepted, short
  # enough that the test can wait one out.
  tombstoneTtl = 20;

  node = { upstream ? null, vlans }: { config, ... }: {
    imports = [ (cache { inherit upstream vlans; }) ];
    virtualisation.vlans = vlans;
    networking.firewall.allowedTCPPorts = [ port ];
    environment.systemPackages = [ pkgs.iproute2 pkgs.busybox synchrony ];
    boot.kernelModules = [ "sch_netem" ];

    systemd.services.synchrony-node = {
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        ExecStart = pkgs.lib.concatStringsSep " " ([
          (pkgs.lib.getExe synchrony)
          "--id ${config.networking.hostName}"
          "--listen ${toString port}"
          "--state-dir /var/lib/synchrony"
        ] ++ (if upstream != null
          then [ "--upstream ${upstream}:${toString port}" ]
          else [ "--tombstone-ttl ${toString tombstoneTtl}" ]));
        Restart = "always";
        StateDirectory = "synchrony";
        RestartSec = 1;
      };
    };
  };
in
pkgs.testers.runNixOSTest {
  name = "synchrony-topology";

  nodes = {
    source = node { vlans = [ 1 ]; };
    node1 = node { vlans = [ 1 2 ]; upstream = "source"; };
    node2 = node { vlans = [ 2 3 ]; upstream = "node1"; };
    node3 = node { vlans = [ 3 ]; upstream = "node2"; };
  };

  testScript = ''
    import time

    # Each guest keeps its own CLOCK_REALTIME and nothing syncs them, so the
    # nodes start hundreds of milliseconds apart. That constant is invisible to
    # Cristian's algorithm and to us, so every assertion below is about how much
    # an estimate MOVES when the network changes, never its absolute value.
    def last_offset_us(m):
        out = m.succeed(
            "journalctl -u synchrony-node -o cat "
            "| grep -o 'offset_us=-\\?[0-9]*' | tail -1"
        )
        return int(out.strip().split("=")[1])


    def settled_offset_us(m, tol_us=3000, tries=40):
        prev = None
        for _ in range(tries):
            time.sleep(1)
            v = last_offset_us(m)
            if prev is not None and abs(v - prev) <= tol_us:
                return v
            prev = v
        raise Exception(f"{m.name} offset never settled, last was {prev}")


    def sync_lines(m):
        out = m.succeed(
            "journalctl -u synchrony-node -o cat | grep ' sync upstream='"
        )
        rows = []
        for line in out.strip().splitlines():
            f = dict(kv.split("=", 1) for kv in line.split() if "=" in kv)
            wall, logical = f["hlc"].split(".")
            rows.append({
                "hlc": (int(wall), int(logical)),
                "stepped_back_us": int(f["stepped_back_us"]),
            })
        return rows


    def log_fields(m, pattern):
        out = m.succeed(
            f"journalctl -u synchrony-node -o cat | grep -E '{pattern}' | tail -1"
        )
        return dict(kv.split("=", 1) for kv in out.split() if "=" in kv)


    def count(m, pattern):
        return int(m.succeed(
            f"journalctl -u synchrony-node -o cat | grep -cE '{pattern}' || true"
        ).strip())


    def get(m, key):
        return m.succeed(f"synchrony-get 127.0.0.1:${toString port} {key}").strip()


    def netem(m, dev, ms, first=False):
        verb = "add" if first else "change"
        m.succeed(f"tc qdisc {verb} dev {dev} root netem delay {ms}ms")


    start_all()

    for m in (source, node1, node2, node3):
        m.wait_for_unit("synchrony-node.service")

    # The point of the whole exercise: node3 can only be heard through the chain.
    node3.fail("ping -c1 -W2 source")
    node3.fail("ping -c1 -W2 node1")
    node3.succeed("ping -c1 -W2 node2")

    # origin is the node that spoke, hops is how many relayed it on, so this
    # asserts both that node3 was heard and that it took the long way round.
    source.wait_until_succeeds(
        "journalctl -u synchrony-node | grep -q 'origin=node3 hops=2'"
    )

    relays = (node1, node2, node3)

    # One row per direction of travel, with the delay each gets in the
    # asymmetric phase: 10ms heading towards the source, 50ms coming back.
    links = (
        (source, "eth1", 50),  # source -> node1
        (node1, "eth1", 10),   # node1  -> source
        (node1, "eth2", 50),   # node1  -> node2
        (node2, "eth1", 10),   # node2  -> node1
        (node2, "eth2", 50),   # node2  -> node3
        (node3, "eth1", 10),   # node3  -> node2
    )

    with subtest("estimates converge on an idle network"):
        base = {m.name: settled_offset_us(m) for m in relays}
        print("baseline offsets (us): " + repr(base))

    # Only source applies writes, and each node pulls only from its upstream,
    # so a write made at node3 has to climb three hops to be applied and then
    # come back down one anti-entropy walk per hop.
    with subtest("a write at node3 goes up to source and back down"):
        source.succeed(
            "synchrony-put 127.0.0.1:${toString port} "
            + " ".join(f"k{i}=v" for i in range(1000))
        )
        node3.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'keys=1000$'"
        )

        node3.succeed("synchrony-put 127.0.0.1:${toString port} written=node3")
        source.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat "
            "| grep -q 'put key=written .* origin=node3 hops=2$'"
        )
        for m in relays:
            m.wait_until_succeeds(
                "journalctl -u synchrony-node -o cat "
                "| grep -q 'applied key=written '"
            )

        # Read off each node's corrected clock against source's stamp, which
        # on an idle network is good to well under a millisecond.
        lag = {m.name: int(log_fields(m, "applied key=written ")["lag_us"])
               for m in relays}
        print("propagation lag from source (us): " + repr(lag))
        assert lag["node1"] < lag["node2"] < lag["node3"], (
            f"write did not arrive in hop order: {lag}"
        )

    # The point of the tree: with 1000 keys already in sync, the walk that
    # carried that one write compared a single branch of hashes, not the store.
    with subtest("one changed key costs one branch, not the dataset"):
        for m in relays:
            first = log_fields(m, "anti-entropy .* keys=1000$")
            one = log_fields(m, "anti-entropy .* keys=1001$")
            print(f"{m.name}: first sync {first['bytes']} bytes, "
                  f"one key {one['bytes']} bytes, {one['hashes']} hashes")
            assert int(one["applied"]) == 1, f"{m.name}: {one}"
            assert int(one["hashes"]) == 1 + 16 * 3, f"{m.name}: {one}"
            assert int(one["bytes"]) * 50 < int(first["bytes"]), (
                f"{m.name}: one key cost {one['bytes']} bytes against "
                f"{first['bytes']} for the whole store"
            )

    with subtest("symmetric delay does not move the estimate"):
        for m, dev, _ in links:
            netem(m, dev, 30, first=True)

        for m in relays:
            moved = settled_offset_us(m) - base[m.name]
            assert abs(moved) < 6000, (
                f"{m.name} moved {moved}us under symmetric delay, "
                "which should cancel"
            )

    # 10ms towards the source, 50ms coming back. Cristian's splits the 60ms
    # round trip down the middle, so each hop is wrong by (10 - 50) / 2 and
    # inherits its upstream's error on top of its own.
    with subtest("asymmetric delay stacks one hop at a time"):
        seen_before = {m.name: len(sync_lines(m)) for m in relays}

        for m, dev, delay_ms in links:
            netem(m, dev, delay_ms)

        moved = {m.name: settled_offset_us(m) - base[m.name] for m in relays}
        print("offset change under asymmetry (us): " + repr(moved))

        for name, expected in (("node1", -20000), ("node2", -40000),
                               ("node3", -60000)):
            assert abs(moved[name] - expected) < 9000, (
                f"{name} moved {moved[name]}us, expected about {expected}us"
            )

        assert (
            abs(moved["node3"]) > abs(moved["node2"]) > abs(moved["node1"])
        ), f"error did not grow with hop count: {moved}"

    # Switching to asymmetric links pulled every offset estimate down by 20ms
    # or more, so every node's corrected clock jumped backwards. The drop can
    # arrive in pieces, since a sync in flight while the links change sees one
    # old direction and one new, hence 5ms: well clear of the tens-of-us jitter
    # but no bigger than the smallest piece. The HLC has to have held through
    # every one of those jumps.
    with subtest("hlc never goes backwards, even when the clock does"):
        for m in relays:
            rows = sync_lines(m)
            stamps = [r["hlc"] for r in rows]
            for earlier, later in zip(stamps, stamps[1:]):
                assert earlier < later, (
                    f"{m.name} hlc went from {earlier} to {later}"
                )

            step = max(rows[seen_before[m.name]:],
                       key=lambda r: r["stepped_back_us"])
            print(f"{m.name}: largest step back {step['stepped_back_us']}us, "
                  f"hlc held at {step['hlc']}")
            assert step["stepped_back_us"] >= 5000, (
                f"{m.name} never stepped back by 5ms: {step}"
            )
            assert step["hlc"][1] >= 1, (
                f"{m.name} stepped back but hlc did not hold: {step}"
            )
  
    # node2 is node3's only way out. With it stopped, node3 has to keep taking
    # writes with nowhere to send them, then hand them over to a node2 that
    # comes back with an empty store, though with its clock restored.
    with subtest("node3 keeps its writes while node2 is down"):
        failed_dials = count(node3, "upstream dial failed")
        drained = count(node3, "landed key=.* outbox=0$")
        node2.succeed("systemctl stop synchrony-node")
        node3.wait_until_succeeds(
            f"[ $(journalctl -u synchrony-node -o cat "
            f"| grep -c 'upstream dial failed') -gt {failed_dials} ]"
        )

        node3.succeed(
            "synchrony-put 127.0.0.1:${toString port} "
            + " ".join(f"outage{i}=v" for i in range(50))
            + " clash=node3"
        )
        # Written after node3's, so it has to win even though node3's arrives
        # later. Asymmetry has node3's clock running about 60ms behind source
        # by now, which is the direction where LWW gets this right; ahead by
        # more than the gap between the two writes and it would not.
        source.succeed("synchrony-put 127.0.0.1:${toString port} clash=source")

        time.sleep(5)
        source.fail("journalctl -u synchrony-node -o cat | grep -q 'key=outage'")
        node2.succeed("systemctl start synchrony-node")

        source.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat "
            "| grep -q 'put key=clash .* origin=node3 hops=2 stale$'"
        )
        node3.wait_until_succeeds(
            f"[ $(journalctl -u synchrony-node -o cat "
            f"| grep -c 'landed key=.* outbox=0$') -gt {drained} ]"
        )

        # 1001 from before, 50 outage keys and clash. node2 lost everything
        # when it stopped, so it has to have refilled from node1.
        for m in relays:
            m.wait_until_succeeds(
                "journalctl -u synchrony-node -o cat | grep -q 'keys=1052$'"
            )

        # The version was fixed when node3 accepted the write, not when source
        # finally got it, so the lag covers the whole outage.
        # Read back from node3's own replica, not inferred from source's log.
        assert get(node3, "clash") == "clash=source", get(node3, "clash")
        assert get(node3, "outage49") == "outage49=v", get(node3, "outage49")

        lag = int(log_fields(node3, "applied key=outage0 ")["lag_us"])
        print(f"outage0 reached node3 {lag}us after node3 accepted it")
        assert lag > 5_000_000, f"lag {lag}us is shorter than the outage"

    def nar_requests(m, status=None):
        rows = [r.split() for r in m.succeed(
            "cat /var/log/nginx/cache.log"
        ).strip().splitlines()]
        return [r for r in rows
                if r[1].startswith("/nar/") and r[2] == "200"
                and (status is None or r[3] == status)]


    # The payoff: a derivation that exists nowhere until source builds it,
    # fetched by a node that cannot even route to source.
    with subtest("a path built on source reaches node3 through two caches"):
        source.succeed(
            "nix-store --generate-binary-cache-key source-1 "
            "/run/cache.sec /run/cache.pub && systemctl start nix-serve"
        )
        source.wait_for_open_port(${toString (cachePort + 1)})
        for m in (source, node1, node2):
            m.wait_for_unit("nginx.service")
        key = source.succeed("cat /run/cache.pub").strip()

        # 10MB of fresh randomness, so nothing on the host or any VM has it.
        # Built rather than added, which makes it input-addressed: node3 only
        # takes it because source signed it, and the relays never sign
        # anything.
        expr = (
            'let bb = builtins.storePath "${pkgs.busybox}"; in derivation { '
            'name = "payload"; system = builtins.currentSystem; '
            'builder = "''${bb}/bin/sh"; '
            'args = [ "-c" "''${bb}/bin/head -c 10000000 /dev/urandom > $out" ]; }'
        )
        path = source.succeed(f"nix-build --no-out-link -E '{expr}'").strip()
        node3.fail(f"nix-store --check-validity {path}")

        trust = f"--option trusted-public-keys '{key}'"
        start = time.monotonic()
        node3.succeed(f"nix-store --realise {path} {trust}")
        cold = time.monotonic() - start

        # node2 substitutes from node1, which now has a copy.
        start = time.monotonic()
        node2.succeed(f"nix-store --realise {path} {trust}")
        warm = time.monotonic() - start
        print(f"node3 through two caches: {cold:.2f}s, "
              f"node2 from node1's copy: {warm:.2f}s")

        def sha(m):
            return m.succeed(f"sha256sum {path}").split()[0]
        assert sha(node3) == sha(source), "node3 got different bytes"
        node3.succeed(f"nix-store --verify-path {path}")

        assert len(nar_requests(node2, "MISS")) == 1, nar_requests(node2)
        assert len(nar_requests(node1, "MISS")) == 1, nar_requests(node1)
        assert len(nar_requests(node1, "HIT")) == 1, nar_requests(node1)
        assert len(nar_requests(source)) == 1, (
            f"source served the nar more than once: {nar_requests(source)}"
        )

    with subtest("a delete at node3 comes back to it as a tombstone"):
        node3.succeed("synchrony-put 127.0.0.1:${toString port} -d k5")
        source.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat "
            "| grep -q 'delete key=k5 .* origin=node3 hops=2$'"
        )
        for m in relays:
            m.wait_until_succeeds(
                "journalctl -u synchrony-node -o cat "
                "| grep -q 'applied key=k5 .* deleted$'"
            )
        node3.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'landed key=k5 '"
        )
        node3.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'keys=1051$'"
        )
        for m in (source, *relays):
            assert get(m, "k5") == "k5 deleted", f"{m.name}: {get(m, 'k5')}"

    # node3 holds k7 when node2 goes down. While it is cut off, source deletes
    # k7 and later collects the tombstone, so when node2 comes back there is
    # nothing anywhere that says k7 was deleted. Upstream lacking a key is
    # also what an upstream that restarted empty looks like, so node3 cannot
    # tell from the walk alone. The horizon is what tells it.
    with subtest("a replica that missed a collected tombstone starts over"):
        node2.succeed("systemctl stop synchrony-node")
        source.succeed("synchrony-put 127.0.0.1:${toString port} -d k7")
        source.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'delete key=k7 '"
        )
        time.sleep(${toString tombstoneTtl} + 5)
        node2.succeed("systemctl start synchrony-node")

        node3.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'refilling from scratch'"
        )
        # 1051 less k7. Kept as a ghost, it would stay 1051 forever.
        node3.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat | grep -q 'keys=1050$'"
        )
        assert get(node3, "k7") == "k7 missing", get(node3, "k7")
        assert get(node3, "k8") == "k8=v", get(node3, "k8")
        assert count(node2, "refilling from scratch") == 0, (
            "node2 restarted empty and had nothing to wipe"
        )

    # Every raw clock here is a few hundred ms ahead of source, so a node that
    # came back on its raw clock would stamp writes in everyone else's future
    # and beat writes made after them, until its first sync.
    with subtest("a restarted node carries its clock across the restart"):
        before = last_offset_us(node3)
        node3.succeed("systemctl restart synchrony-node")
        node3.succeed("synchrony-put 127.0.0.1:${toString port} after_restart=1")
        node1.wait_until_succeeds(
            "journalctl -u synchrony-node -o cat "
            "| grep -q 'applied key=after_restart '"
        )

        restored = int(log_fields(node3, "restored clock")["offset_us"])
        lag = int(log_fields(node1, "applied key=after_restart ")["lag_us"])
        print(f"node3 offset {before}us before, restored {restored}us; "
              f"its first write reached node1 {lag}us after it was stamped")
        assert abs(restored - before) <= 1000, (before, restored)
        assert lag > -10_000, f"write was stamped {-lag}us in node1's future"

        stamps = [r["hlc"] for r in sync_lines(node3)]
        assert all(a < b for a, b in zip(stamps, stamps[1:])), (
            "node3's hlc went backwards across the restart"
        )
  '';
}
